agnosis&lt;br&gt;codes, completed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1E3A5F;strokeWidth=2;fillColor=#DBEAFE;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="s6" value="Procedure diagnosis&lt;br&gt;codes, planned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1E3A5F;strokeWidth=2;fillColor=#DBEAFE;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="s7" value="Probing chart&lt;br&gt;CAL · RBL · teeth lost" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#1E3A5F;strokeWidth=2;fillColor=#DBEAFE;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="rad" value="Radiograph AI (exploratory) · bone level per tooth" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#7D8998;strokeWidth=2;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="1210" y="215" width="350" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Qualitative" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAEDED;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="740" height="34" as="geometry"/></mxCell><mxCell id="cmp" value="Compare each evidence type with every other&lt;br&gt;agreement, kappa, coverage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#15803D;strokeWidth=2;fillColor=#DCFCE7;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="340" height="60" as="geometry"/></mxCell><mxCell id="qr" value="Qualitative review&lt;br&gt;two dental reviewers, disagreeing charts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#232F3E;strokeColor=#15803D;strokeWidth=2;fillColor=#DCFCE7;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="360" hei