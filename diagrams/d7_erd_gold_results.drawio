l=1;fontSize=12;strokeColor=#7D8998;fillColor=#F5F5F5;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="330" height="118" as="geometry"/></mxCell><mxCell id="key_f0" value="PK visit_id  BIGINT  (240 synthetic charts)" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="key"><mxGeometry y="30" width="330" height="22" as="geometry"/></mxCell><mxCell id="key_f1" value="truth_status  STRING" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;" vertex="1" parent="key"><mxGeometry y="52" width="330" height="22" as="geometry"/></mxCell><mxCell id="key_f2" value="difficulty  STRING  L1 · L2 · L3" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;" vertex="1" parent="key"><mxGeometry y="74" width="330" height="22" as="geometry"/></mxCell><mxCell id="key_f3" value="note_text  STRING  (de-identified)" style="text;strokeColor=none;fillColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;" vertex="1" parent="key"><mxGeometry y="96" width="330" height="22" as="geometry"/></mxCell><mxCell id="c2" value="sha256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="rf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="sha256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lr" target="rf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="70"/><mxPoint x="205" y="70"/></Array></mxGeometry></mxCell><mxCell id="c4" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERzeroToOne;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.21;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="lr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="visit_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ap" target="key"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="655" y="479"/></Array></mxGeometry></mxCell><mxCell id="c6" value="visit_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="lr" target="key"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="467"/><mxPoint x="880" y="514"/></Array></mxGeometry></mxCell><mxCell id="c7" value="Keys and idempotency. Load results rows (source repo · kaggle): one result_files row per file version; its rows in ai_predictions / llm_reader_runs carry that sha256, deleted then appended on a reload, so loading again adds nothing and a changed file is a new version (old rows stay). Reader job rows (source databricks): keyed by (source, run_id, method); a retry replaces them; their sha256 is the scratch CSV's and has no result_files row (dashed: a logical link, not enforced). ai_predictions ↔ llm_reader_runs: one LLM details row per LLM prediction, matched on method + visit_id + source (+ run_id for databricks rows). Delta has no enforced keys: PK marks the logical key. Probabilities (p_*) stay in the committed CSV. simulated_* files are never loaded." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="860" height="105" as="geometry"/></mxCell><mxCell id="c8" value="Read ai_predictions for one result per method: filter to the latest sha256 per (source, method), or to one run_id." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="860" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>