dge="1" parent="1" source="ca" target="jd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="status: visit_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="ca" target="jd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="205"/><mxPoint x="415" y="226"/></Array></mxGeometry></mxCell><mxCell id="c4" value="system" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ca" target="jm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="vs_judge · corrected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.8035;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jd" target="jm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="status rows vs truth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jd" target="ja"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="kind" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;strokeColor=#545B64;strokeWidth=1.2;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="jd" target="jr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="Solid: row-level join (the dashboard's chart drill-down: chart_answers LEFT JOIN judgments s ON visit_id AND s.kind = 'status', LEFT JOIN judgments v ON visit_id AND v.kind = 'verdict' AND v.answer = a.answer). One verdict serves every system that gave that answer on that chart. Dashed: the summary table is computed from these rows in python/dental_omop_nlp/judge_scorecard.py, not joined." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1250" height="50" as="geometry"/></mxCell><mxCell id="c9" value="chart_answers.system equals ai_predictions.method for the AI systems, plus +rules4 variants, the rule-based phenotype and each evidence type alone. Metrics are computed in code, never by the LLM. Overwritten every run (judgments kept and resumed). CSV twins: data/datasets/judge/." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="1250" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>